# PromptLaunch — Environment Variables
# Copy this to .env and fill in your values. Never commit .env to git.

# ─── Django ───────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Gemini API ───────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ─── Database (leave blank to use SQLite for local dev) ──────────────────
# DB_NAME=promptlaunch
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ─── CORS (dev) ───────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=True
