# ==============================================================================
# Blynkpages Enterprise Configuration — Environment Template
# ==============================================================================

# ─── Django Core & Security ───────────────────────────────────────────────────
# Generate a secure 50+ char random key in production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=django-insecure-replace-this-with-a-long-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.blynkpage.com,blynkpage.com

# ─── Database (PostgreSQL with Connection Pooling) ────────────────────────────
# REQUIRED in production. SQLite is NOT supported — it will corrupt data under concurrent writes.
# Use the production settings module: DJANGO_SETTINGS_MODULE=promptlaunch.settings.production
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/blynkpages

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Access token validity: 1 day by default, Refresh token validity: 14 days
# Refresh tokens are stored in httpOnly cookies (NEVER in JS-accessible storage).
JWT_SECRET_KEY=use-different-secret-for-jwt-if-desired

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─── Generation Quota (per-user per-day, plan enforcement) ───────────────────
DAILY_GENERATION_QUOTA=20

# ─── CORS & Frontend Integration ──────────────────────────────────────────────
# In production, set to False and specify exact allowed origins
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://blynkpage.com

# ─── Meta Pixel & CAPI ───────────────────────────────────────────────────────
# These are stored per-user in the DB (via /api/account/pixel/).
# The values below are defaults only — users set their own in-app.
# META_PIXEL_ID=  (set per-user in app)
# META_ACCESS_TOKEN=  (set per-user in app, used for server-side CAPI)

# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
# Optional but strongly recommended for production.
# Get your DSN at: https://sentry.io/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── Production Settings Module ───────────────────────────────────────────────
# To use the production settings (with PostgreSQL guard, HSTS, strict CORS):
# DJANGO_SETTINGS_MODULE=promptlaunch.settings.production
# (Default is: promptlaunch.settings.local for local development)

# ─── Frontend Environment (Vite) ──────────────────────────────────────────────
# When running frontend separately in production:
# VITE_API_URL=https://api.blynkpage.com
